@page "/titles"
@attribute [StreamRendering]
@using Microsoft.EntityFrameworkCore
@using OEBG.PLAGG.Data
@inject IDbContextFactory<TitlesDbContext> DbContextFactory

<PageTitle>Titles</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <h1>Titles</h1>

    <FluentLabel Typo="Typography.Body">
        This component demonstrates titles from an SQL database.
    </FluentLabel>

    <FluentDataGrid Items="@titlesQueryable" ResizableColumns="true" Loading="@(titlesQueryable==null)">
        <PropertyColumn Property="@(t => t.Id)" Sortable="true" Title="ID" />
        <PropertyColumn Property="@(t => t.TitleText)" Sortable="true" Title="Title" />
    </FluentDataGrid>
</FluentStack>

@code {
    private IQueryable<Title>? titlesQueryable;

    protected override async Task OnInitializedAsync() {
        await using var context = await DbContextFactory.CreateDbContextAsync();
        var titles = await context.Titles.AsNoTracking().ToArrayAsync();
        titlesQueryable = titles.AsQueryable();
    }
}
