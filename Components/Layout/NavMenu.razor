<FluentNav>
    <FluentNavCategory Title="Main Navigation">
        <FluentNavItem Href="/" Match="NavLinkMatch.All">Home</FluentNavItem>
        <FluentNavItem Href="counter">Counter</FluentNavItem>
        <FluentNavItem Href="weather">Weather</FluentNavItem>
        <FluentNavItem Href="titles">Titles</FluentNavItem>
        <FluentNavItem Href="auth">Auth Required</FluentNavItem>
    </FluentNavCategory>

    <AuthorizeView>
        <Authorized>
            <FluentDivider />
            <FluentNavSectionHeader>User</FluentNavSectionHeader>
            <FluentStack Orientation="Orientation.Vertical" Style="padding: 10px;">
                <FluentLabel>@context.User.Identity?.Name</FluentLabel>
            </FluentStack>
        </Authorized>
    </AuthorizeView>
</FluentNav>

